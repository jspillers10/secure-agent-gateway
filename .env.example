# Reference only: Docker Compose sets these itself in docker-compose.yml.
# Use this file if you want to run `uvicorn gateway.main:create_app --factory`
# directly on the host instead of via Docker. Note that in the hardened
# Compose topology, OPA has no published port (see docker-compose.yml), so
# OPA_URL below (localhost:8181) only works for a host-run gateway talking
# to a host-run `opa run --server` process, not to the Compose stack.
#
# No real secrets belong in this file. JWT_PUBLIC_KEY_FILE should point at
# a locally-generated, gitignored key (see scripts/generate_dev_keys.py).
# APPROVER_API_KEY and APPROVER_IDENTITY here are placeholder values for
# local use only.
#
# JWT_ALGORITHM must be exactly "RS256"; load_settings() rejects any
# other value (including HS256 and none) at startup. See
# src/gateway/config.py and src/gateway/identity/tokens.py.

JWT_ISSUER=https://issuer.secure-agent-gateway.local
JWT_AUDIENCE=secure-agent-gateway
JWT_PUBLIC_KEY_FILE=./devkeys/public.pem
JWT_ALGORITHM=RS256
OPA_URL=https://localhost:8181
LAUNCHER_URL=https://localhost:8443
INTERNAL_CA_CERT_FILE=./devkeys/internal-server-ca-cert.pem
GATEWAY_CLIENT_CERT_FILE=./devkeys/gateway-client-cert.pem
GATEWAY_CLIENT_KEY_FILE=./devkeys/gateway-client-key.pem
EXECUTION_GRANT_PRIVATE_KEY_FILE=./devkeys/execution-grant-private.pem
EXECUTION_GRANT_PUBLIC_KEY_FILE=./devkeys/execution-grant-public.pem
EXECUTION_GRANT_ISSUER=secure-agent-gateway
EXECUTION_GRANT_AUDIENCE=secure-agent-worker-launcher
EXECUTION_GRANT_TTL_SECONDS=30
LAUNCHER_TIMEOUT_SECONDS=10.0
APPROVER_API_KEY=dev-only-approver-key-not-a-secret
APPROVER_IDENTITY=dev-local-approver
POLICY_TIMEOUT_SECONDS=2.0
