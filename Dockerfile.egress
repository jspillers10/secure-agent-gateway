# syntax=docker/dockerfile:1
FROM python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && groupadd --gid 20000 egress \
    && useradd --no-create-home --uid 10002 --gid 20000 --shell /usr/sbin/nologin egress \
    && mkdir -p /run/secure-agent-egress \
    && chown 10002:20000 /run/secure-agent-egress \
    && chmod 0770 /run/secure-agent-egress

USER 10002:20000
ENTRYPOINT ["python", "-m", "gateway.egress.main"]
