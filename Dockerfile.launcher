# syntax=docker/dockerfile:1
FROM python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[launcher]"

CMD ["uvicorn", "gateway.launcher.app:create_launcher_app", "--factory", "--host", "0.0.0.0", "--port", "8443", "--ssl-certfile", "/keys/launcher-cert.pem", "--ssl-keyfile", "/keys/launcher-key.pem", "--ssl-ca-certs", "/keys/gateway-client-ca-cert.pem", "--ssl-cert-reqs", "2"]
