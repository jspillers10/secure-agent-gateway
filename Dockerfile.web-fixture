# syntax=docker/dockerfile:1
FROM python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /fixture
COPY scripts/web_fixture.py ./web_fixture.py
COPY scripts/protected_connection_fixture.py ./protected_connection_fixture.py
RUN mkdir /observations && chmod 0777 /observations
USER 10003:10003
ENTRYPOINT ["python", "/fixture/web_fixture.py"]
