# syntax=docker/dockerfile:1
FROM python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && useradd --no-create-home --uid 10001 --shell /usr/sbin/nologin worker

LABEL org.secure-agent.role="disposable-worker" \
      org.secure-agent.artifact-digest="sha256:33a885ff194feb4aa5310767de9b08ffd31495f1923dc81c0c63dd19d0fe288b"

USER 10001:10001
ENTRYPOINT ["python", "-m", "gateway.worker.main"]
